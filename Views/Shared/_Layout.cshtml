<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TeamMall</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TeaMall.styles.css" asp-append-version="true" />
</head>

<body class="tm-body">

    <div class="tm-app">

        <!-- Menú lateral -->
        <aside class="offcanvas-lg offcanvas-start tm-sidebar"
               tabindex="-1"
               id="sidebarMenu"
               aria-labelledby="sidebarTitle">

            <div class="offcanvas-header tm-sidebar-header">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="tm-brand"
                   id="sidebarTitle">
                    <span class="tm-brand-symbol">T</span>
                    <span>TeamMall</span>
                </a>

                <button type="button"
                        class="btn-close btn-close-white d-lg-none"
                        data-bs-dismiss="offcanvas"
                        aria-label="Cerrar menú">
                </button>
            </div>

            <div class="offcanvas-body tm-sidebar-body">

                <div class="tm-menu-label">MENÚ PRINCIPAL</div>

                <nav class="tm-nav">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        <span class="tm-nav-icon">⌂</span>
                        <span>Inicio</span>
                    </a>

                    <a asp-controller="Locales"
                       asp-action="Index"
                       class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Locales" ? "active" : "")">
                        <span class="tm-nav-icon">▤</span>
                        <span>Locales</span>
                    </a>

                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-controller="Usuarios"
                           asp-action="Index"
                           class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")">
                            <span class="tm-nav-icon">♙</span>
                            <span>Usuarios</span>
                        </a>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Perfil"
                           asp-action="Index"
                           class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Perfil" ? "active" : "")">
                            <span class="tm-nav-icon">♡</span>
                            <span>Mi perfil</span>
                        </a>
                    }

                    <div class="tm-menu-label mt-4">COMUNICACIÓN</div>

                    <a asp-controller="Publicaciones"
                       asp-action="Index"
                       class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Publicaciones" ? "active" : "")">
                        <span class="tm-nav-icon">▧</span>
                        <span>Publicaciones</span>
                    </a>

                    <a asp-controller="Inasistencias"
                       asp-action="Index"
                       class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inasistencias" ? "active" : "")">
                        <span class="tm-nav-icon">▣</span>
                        <span>Inasistencias</span>
                    </a>

                    <a asp-controller="Notificaciones"
                       asp-action="Index"
                       class="tm-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notificaciones" ? "active" : "")">
                        <span class="tm-nav-icon">♧</span>
                        <span>Notificaciones</span>
                    </a>

                </nav>

                <div class="tm-sidebar-footer">
                    <span class="tm-status-dot"></span>
                    <span>TeamMall · Gestión interna</span>
                </div>

                <!-- Cerrar sesión -->
                <form asp-controller="Login"
                      asp-action="Logout"
                      method="post"
                      class="tm-logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="tm-logout-btn">
                        <span class="tm-logout-icon">↪</span>
                        <span>Cerrar sesión</span>
                    </button>
                </form>

            </div>
        </aside>

        <!-- Área principal -->
        <div class="tm-main">

            <!-- Barra superior -->
            <header class="tm-topbar">

                <div class="d-flex align-items-center gap-3">

                    <button class="btn tm-menu-toggle d-lg-none"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#sidebarMenu"
                            aria-controls="sidebarMenu"
                            aria-label="Abrir menú">
                        ☰
                    </button>

                    <div>
                        <div class="tm-topbar-brand">TeamMall</div>
                        <div class="tm-topbar-subtitle">
                            Gestión interna
                        </div>
                    </div>

                </div>

                <!-- Usuario autenticado -->
                <a asp-controller="Perfil"
                   asp-action="Index"
                   class="tm-user-area text-decoration-none">

                    @{
                        var avatarUsuario = User.FindFirst("Avatar")?.Value;
                        var nombreUsuario = User.Identity?.Name;
                        var inicialUsuario = !string.IsNullOrWhiteSpace(nombreUsuario)
                            ? nombreUsuario.Substring(0, 1).ToUpper()
                            : "T";
                    }

                    @if (User.Identity?.IsAuthenticated == true &&
                         !string.IsNullOrWhiteSpace(avatarUsuario))
                    {
                        <img src="@avatarUsuario"
                             alt="Foto de perfil"
                             class="tm-user-avatar"
                             asp-append-version="true" />
                    }
                    else
                    {
                        <div class="tm-user-avatar tm-user-avatar-initial">
                            @inicialUsuario
                        </div>
                    }

                    <div class="d-none d-sm-block">
                        <div class="tm-user-name">
                            @(User.Identity?.IsAuthenticated == true
                                ? User.Identity.Name
                                : "Invitado")
                        </div>

                        <div class="tm-user-role">
                            @(User.Identity?.IsAuthenticated == true
                                ? (User.IsInRole("Administrador")
                                    ? "Administrador"
                                    : User.IsInRole("Vendedor")
                                        ? "Vendedor"
                                        : "Usuario")
                                : "Sin sesión iniciada")
                        </div>
                    </div>

                </a>

            </header>

            <!-- Contenido de cada vista -->
            <main role="main" class="tm-content">
                @RenderBody()
            </main>

            <footer class="tm-footer">
                <span>TeamMall</span>
                <span>Gestión y comunicación interna</span>
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
