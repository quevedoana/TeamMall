@model IEnumerable<TeaMall.Models.Inasistencia>

@{
    ViewData["Title"] = "Inasistencias";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Inasistencias</h1>
        <p class="text-muted mb-0">
            Gestión de inasistencias y justificaciones
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Nueva inasistencia
    </a>
</div>

@if (User.IsInRole("Administrador"))
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Filtrar inasistencias
            </h5>

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-md-3">
                        <label class="form-label">
                            Fecha desde
                        </label>

                        <input type="date"
                               name="fechaDesde"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Fecha hasta
                        </label>

                        <input type="date"
                               name="fechaHasta"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Tipo
                        </label>

                        <select name="tipo" class="form-select">

                            <option value="">
                                Todos
                            </option>

                            <option value="Certificado médico">
                                Certificado médico
                            </option>

                            <option value="Justificación">
                                Justificación
                            </option>

                        </select>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary me-2">
                            Buscar
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Limpiar
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay inasistencias cargadas.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Tipo</th>
                    <th>Fecha de ausencia</th>
                    <th>Fecha de carga</th>
                    <th>Comentario</th>
                    <th>Archivo</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var inasistencia in Model)
                {
                    <tr>

                        <td>
                            @inasistencia.IdUsuario
                        </td>

                        <td>
                            @inasistencia.Tipo
                        </td>

                        <td>
                            @inasistencia.FechaAusencia.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @inasistencia.FechaCarga.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @inasistencia.Comentario
                        </td>

                        <td>

                            @if (!string.IsNullOrEmpty(
                                inasistencia.Archivo))
                            {
                                <a href="@inasistencia.Archivo"
                                   target="_blank"
                                   class="btn btn-outline-primary btn-sm">
                                    Ver archivo
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sin archivo
                                </span>
                            }

                        </td>

                        <td>

                            @if (inasistencia.Estado == "Pendiente")
                            {
                                <span class="badge bg-warning text-dark">
                                    Pendiente
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    @inasistencia.Estado
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}