@model TeaMall.Models.Inasistencia

@{
    ViewData["Title"] = "Nueva inasistencia";
}

<h1>Nueva inasistencia</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Tipo" class="form-label"></label>

                <select asp-for="Tipo" class="form-select">
                    <option value="">Seleccione un tipo</option>
                    <option value="Certificado médico">Certificado médico</option>
                    <option value="Justificación">Justificación</option>
                </select>

                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaAusencia" class="form-label"></label>
                <input asp-for="FechaAusencia" type="date" class="form-control" />
                <span asp-validation-for="FechaAusencia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Comentario" class="form-label"></label>
                <textarea asp-for="Comentario"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Comentario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Archivo</label>
                <input type="file"
                       name="ArchivoSubido"
                       class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar
            </button>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>

        </form>

    </div>
</div>