
@{
    ViewData["Title"] = "Locales";
}

<div id="appLocales">
    <form id="formToken" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="tm-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Locales</h1>
            <p class="text-muted mb-0">
                Administrá los locales asociados a TeamMall.
            </p>
        </div>

        <a href="@Url.Action("Create", "Locales")"
           class="btn tm-btn-primary">
            <span class="me-2">+</span> Nuevo local
        </a>
    </div>

    <div class="tm-card">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
            <div>
                <h5 class="mb-1">Listado de locales</h5>
                <p class="text-muted small mb-0">
                    Consultá y administrá los locales registrados.
                </p>
            </div>

            <div class="tm-local-search">
                <label for="buscarLocal" class="form-label small fw-semibold mb-2">
                    Buscar locales
                </label>

                <div class="tm-search-input">
                    <span class="tm-search-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="19" height="19"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round">
                            <circle cx="10.8" cy="10.8" r="6.8"></circle>
                            <path d="m16 16 4.5 4.5"></path>
                        </svg>
                    </span>

                    <input id="buscarLocal"
                           type="search"
                           v-model="busqueda"
                           class="form-control"
                           placeholder="Nombre del local..."
                           aria-label="Buscar locales por nombre"
                           autocomplete="off" />

                    <button v-if="busqueda"
                            type="button"
                            class="tm-search-clear"
                            aria-label="Limpiar búsqueda"
                            title="Limpiar búsqueda"
                            v-on:click="busqueda = ''">
                        <svg viewBox="0 0 24 24" width="16" height="16"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round">
                            <path d="m18 6-12 12M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>

                <div class="tm-search-results">
                    <span class="tm-search-dot"></span>
                    <span>
                        {{ total }}
                        {{ total === 1 ? 'local encontrado' : 'locales encontrados' }}
                    </span>
                </div>
            </div>
        </div>

        <div v-if="cargando" class="text-center py-5">
            Cargando locales...
        </div>

        <div v-else-if="error" class="alert alert-danger">
            {{ error }}
            <button type="button"
                    class="btn btn-sm btn-outline-danger ms-2"
                    v-on:click="cargarLocales()">
                Reintentar
            </button>
        </div>

        <div v-else-if="locales.length === 0" class="text-center py-5">
            <div class="mb-3" style="font-size: 2.5rem;">🏬</div>

            <h5>
                {{ busqueda ? 'No se encontraron locales' : 'Todavía no hay locales' }}
            </h5>

            <p class="text-muted">
                {{ busqueda
                    ? 'Probá con otro nombre.'
                    : 'Creá el primer local para comenzar.' }}
            </p>

            <a v-if="!busqueda"
               href="@Url.Action("Create", "Locales")"
               class="btn tm-btn-primary">
                Crear local
            </a>
        </div>

        <div v-else>
            <div class="table-responsive">
                <table class="table tm-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Local</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr v-for="local in locales" v-bind:key="local.idLocal">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="tm-local-icon">🏬</div>
                                    <div>
                                        <div class="fw-semibold">{{ local.nombre }}</div>
                                        <div class="text-muted small">
                                            ID: {{ local.idLocal }}
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span v-if="local.activo" class="tm-badge-active">
                                    <span class="tm-status-dot"></span>
                                    Activo
                                </span>

                                <span v-else class="tm-badge-inactive">
                                    <span class="tm-status-dot"></span>
                                    Inactivo
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <a v-bind:href="'@Url.Action("Edit", "Locales")?id=' + local.idLocal"
                                       class="btn btn-sm tm-btn-edit">
                                        Editar
                                    </a>

                                    <button v-if="local.activo"
                                            type="button"
                                            class="btn btn-sm tm-btn-disable"
                                            v-on:click="desactivar(local.idLocal)">
                                        Desactivar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mt-4">
                <span class="text-muted small">
                    Página {{ paginaActual }} de {{ totalPaginas }}
                    · {{ total }} locales en total
                </span>

                <nav aria-label="Paginación de locales"
                     class="d-flex align-items-center gap-2">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            v-bind:disabled="paginaActual <= 1 || cargando"
                            v-on:click="cargarLocales(paginaActual - 1)">
                        Anterior
                    </button>

                    <button v-for="pagina in paginasVisibles"
                            v-bind:key="pagina"
                            type="button"
                            class="btn btn-sm"
                            v-bind:class="pagina === paginaActual
                                ? 'tm-btn-primary'
                                : 'btn-outline-secondary'"
                            v-bind:disabled="cargando"
                            v-on:click="cargarLocales(pagina)">
                        {{ pagina }}
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            v-bind:disabled="paginaActual >= totalPaginas || cargando"
                            v-on:click="cargarLocales(paginaActual + 1)">
                        Siguiente
                    </button>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    locales: [],
                    cargando: true,
                    error: '',
                    busqueda: '',
                    paginaActual: 1,
                    tamaño: 5,
                    total: 0,
                    totalPaginas: 0,
                    temporizadorBusqueda: null
                };
            },

            computed: {
                paginasVisibles() {
                    const inicio = Math.max(1, this.paginaActual - 2);
                    const fin = Math.min(this.totalPaginas, inicio + 4);
                    const primerNumero = Math.max(1, fin - 4);

                    return Array.from(
                        { length: fin - primerNumero + 1 },
                        (_, i) => primerNumero + i
                    );
                }
            },

            watch: {
                busqueda() {
                    clearTimeout(this.temporizadorBusqueda);

                    this.temporizadorBusqueda = setTimeout(() => {
                        this.cargarLocales(1);
                    }, 300);
                }
            },

            methods: {
                async cargarLocales(pagina = this.paginaActual) {
                    this.cargando = true;
                    this.error = '';

                    try {
                        const parametros = new URLSearchParams({
                            pagina: pagina,
                            tamaño: this.tamaño,
                            busqueda: this.busqueda.trim()
                        });

                        const respuesta = await fetch(
                            '@Url.Action("Listar", "Locales")?' + parametros.toString()
                        );

                        if (!respuesta.ok) {
                            throw new Error(
                                'No se pudieron obtener los locales. Código: ' +
                                respuesta.status
                            );
                        }

                        const datos = await respuesta.json();

                        this.locales = datos.locales;
                        this.paginaActual = datos.pagina;
                        this.total = datos.total;
                        this.totalPaginas = datos.totalPaginas;
                    } catch (error) {
                        console.error('Error al cargar locales:', error);
                        this.error = error.message ||
                            'Ocurrió un error al cargar los locales.';
                    } finally {
                        this.cargando = false;
                    }
                },

                async desactivar(idLocal) {
                    if (!confirm('¿Seguro que querés desactivar este local?')) {
                        return;
                    }

                    const tokenInput = document.querySelector(
                        '#formToken input[name="__RequestVerificationToken"]'
                    );

                    if (!tokenInput) {
                        alert('No se encontró el token de seguridad. Recargá la página.');
                        return;
                    }

                    try {
                        const urlDesactivar =
                            '@Url.Action("Desactivar", "Locales", new { id = "__ID__" })'
                                .replace('__ID__', idLocal);

                        const respuesta = await fetch(urlDesactivar, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: new URLSearchParams({
                                '__RequestVerificationToken': tokenInput.value
                            })
                        });

                        if (!respuesta.ok) {
                            throw new Error(
                                'No se pudo desactivar el local. Código: ' +
                                respuesta.status
                            );
                        }

                        const resultado = await respuesta.json();

                        const local = this.locales.find(
                            l => l.idLocal === resultado.idLocal
                        );

                        if (local) {
                            local.activo = false;
                        }

                        alert(resultado.mensaje);
                    } catch (error) {
                        console.error('Error al desactivar:', error);
                        alert(error.message ||
                            'Ocurrió un error al desactivar el local.');
                    }
                }
            },

            mounted() {
                this.cargarLocales(1);
            },

            beforeUnmount() {
                clearTimeout(this.temporizadorBusqueda);
            }
        }).mount('#appLocales');
    </script>
}
