@model IEnumerable<TeaMall.Models.Local>

@{
    ViewData["Title"] = "Locales";
}

<div class="tm-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Locales</h1>
        <p class="text-muted mb-0">Administrá los locales asociados a TeamMall.</p>
    </div>

    <a asp-action="Create" class="btn tm-btn-primary">
        <span class="me-2">+</span> Nuevo local
    </a>
</div>

<div class="tm-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h5 class="mb-1">Listado de locales</h5>
            <p class="text-muted small mb-0">Consultá y administrá los locales registrados.</p>
        </div>

        <span class="badge rounded-pill text-bg-light border">
            Total: @(Model?.Count() ?? 0)
        </span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3" style="font-size: 2.5rem;">🏬</div>
            <h5>Todavía no hay locales</h5>
            <p class="text-muted">Creá el primer local para comenzar.</p>
            <a asp-action="Create" class="btn tm-btn-primary">
                Crear local
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table tm-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Local</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var local in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="tm-local-icon">🏬</div>
                                    <div>
                                        <div class="fw-semibold">@local.Nombre</div>
                                        <div class="text-muted small">ID: @local.IdLocal</div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @if (local.Activo)
                                {
                                    <span class="tm-badge-active">
                                        <span class="tm-status-dot"></span> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="tm-badge-inactive">
                                        <span class="tm-status-dot"></span> Inactivo
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@local.IdLocal"
                                       class="btn btn-sm tm-btn-edit">
                                        Editar
                                    </a>

                                    @if (local.Activo)
                                    {
                                        <form asp-action="Desactivar"
                                              asp-route-id="@local.IdLocal"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Seguro que querés desactivar este local?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm tm-btn-disable">
                                                Desactivar
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
