
@model TeaMall.Models.Local

@{
    ViewData["Title"] = "Editar local";
}

<div id="appEditarLocal">
    <div class="tm-page-header mb-4">
        <a asp-action="Index" class="tm-back-link">← Volver a locales</a>
        <h1 class="mt-3 mb-1">Editar local</h1>
        <p class="text-muted mb-0">Modificá la información del local seleccionado.</p>
    </div>

    <div class="tm-form-card">
        <div class="tm-form-heading">
            <div class="tm-form-icon">✎</div>
            <div>
                <h5 class="mb-1">Datos del local</h5>
                <p class="text-muted small mb-0">Local ID: @Model.IdLocal</p>
            </div>
        </div>

        <hr class="tm-form-divider" />

        <form v-on:submit.prevent="guardarCambios">
            @Html.AntiForgeryToken()

            <input type="hidden" v-model="idLocal" />

            <div v-if="error" class="alert alert-danger">
                {{ error }}
            </div>

            <div v-if="exito" class="alert alert-success">
                {{ exito }}
            </div>

            <div class="mb-4">
                <label for="Nombre" class="form-label tm-form-label">
                    Nombre del local <span class="text-danger">*</span>
                </label>

                <input id="Nombre"
                       v-model.trim="nombre"
                       class="form-control tm-input"
                       required
                       maxlength="100" />
            </div>

            <div class="tm-status-option mb-4">
                <div>
                    <div class="fw-semibold">Local activo</div>
                    <div class="text-muted small">
                        Podés cambiar el estado del local desde acá.
                    </div>
                </div>

                <div class="form-check form-switch">
                    <input v-model="activo"
                           type="checkbox"
                           class="form-check-input tm-switch"
                           role="switch" />
                </div>
            </div>

            <div class="tm-form-actions">
                <a asp-action="Index" class="btn tm-btn-cancel">Cancelar</a>

                <button type="submit"
                        class="btn tm-btn-primary"
                        v-bind:disabled="guardando">
                    {{ guardando ? 'Guardando...' : 'Guardar cambios' }}
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    idLocal: @Model.IdLocal,
                    nombre: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Nombre)),
                    activo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Activo)),
                    guardando: false,
                    error: '',
                    exito: ''
                };
            },

            methods: {
                async guardarCambios() {
                    this.error = '';
                    this.exito = '';

                    if (!this.nombre) {
                        this.error = 'Ingresá el nombre del local.';
                        return;
                    }

                    const token = document.querySelector(
                        '#appEditarLocal input[name="__RequestVerificationToken"]'
                    )?.value;

                    if (!token) {
                        this.error = 'No se encontró el token de seguridad. Recargá la página.';
                        return;
                    }

                    this.guardando = true;

                    try {
                        const respuesta = await fetch(
                            '@Url.Action("Edit", "Locales", new { id = Model.IdLocal })',
                            {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': token
                                },
                                body: JSON.stringify({
                                    idLocal: this.idLocal,
                                    nombre: this.nombre,
                                    activo: this.activo
                                })
                            }
                        );

                        const resultado = await respuesta.json();

                        if (!respuesta.ok) {
                            throw new Error(
                                resultado.mensaje || 'No se pudieron guardar los cambios.'
                            );
                        }

                        this.exito = resultado.mensaje;

                    } catch (error) {
                        console.error('Error al editar el local:', error);
                        this.error = error.message ||
                            'Ocurrió un error al guardar los cambios.';
                    } finally {
                        this.guardando = false;
                    }
                }
            }
        }).mount('#appEditarLocal');
    </script>
}
