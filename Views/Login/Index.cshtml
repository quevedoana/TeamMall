@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión | TeamMall</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #F4F7F6;
            font-family: Arial, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 36px;
            background: white;
            border-radius: 18px;
            box-shadow: 0 8px 30px rgba(6, 59, 44, 0.10);
        }

        .login-logo {
            color: #063B2C;
            font-size: 30px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 8px;
        }

        .login-subtitle {
            color: #6c757d;
            text-align: center;
            margin-bottom: 28px;
        }

        .form-control {
            padding: 12px;
            border-radius: 9px;
        }

        .btn-login {
            width: 100%;
            padding: 12px;
            color: white;
            background: #063B2C;
            border: none;
            border-radius: 9px;
            font-weight: 600;
        }

        .btn-login:hover {
            background: #0a513d;
            color: white;
        }
    </style>
</head>

<body>
    <div class="login-card">
        <div class="login-logo">TeamMall</div>
        <p class="login-subtitle">Ingresá a tu cuenta</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Login" asp-action="Index" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="dni" class="form-label">DNI</label>
                <input type="text"
                       id="dni"
                       name="dni"
                       class="form-control"
                       inputmode="numeric"
                       autocomplete="username"
                       maxlength="8"
                       required />
            </div>

            <div class="mb-4">
                <label for="contrasenia" class="form-label">Contraseña</label>
                <input type="password"
                       id="contrasenia"
                       name="contrasenia"
                       class="form-control"
                       autocomplete="current-password"
                       required />
            </div>

            <button type="submit" class="btn btn-login">
                Iniciar sesión
            </button>
        </form>
    </div>
</body>
</html>