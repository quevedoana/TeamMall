@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Accesos a la publicación";
    var publicacion = ViewBag.Publicacion as TeaMall.Models.Publicacion;
}

<div class="tm-page-header">

    <div>

        <h1 class="tm-page-title">
            Accesos a la publicación
        </h1>

        @if (publicacion != null)
        {
            <p class="tm-page-description">
                @publicacion.Titulo
            </p>
        }

    </div>

    <a asp-action="Index"
       class="tm-btn-secondary">
        Volver
    </a>

</div>


<div class="tm-card tm-publicacion-accesos-card">

    @if (!Model.Any())
    {
        <div class="tm-publicacion-accesos-vacio">

            <div class="tm-publicacion-accesos-vacio-icono">
                ✓
            </div>

            <h5>
                Ningún vendedor recibió esta publicación
            </h5>

            <p>
                Todavía no hay vendedores asociados a esta publicación.
            </p>

        </div>
    }
    else
    {
        <div class="tm-publicacion-accesos-header">

            <div>

                <h5>
                    Seguimiento de accesos
                </h5>

                <p>
                    Consultá quién recibió la publicación y quién ingresó a ella.
                </p>

            </div>

            <div class="tm-publicacion-accesos-total">

                <span>
                    @Model.Count()
                </span>

                <small>
                    vendedor@(Model.Count() == 1 ? "" : "es")
                </small>

            </div>

        </div>


        <div class="table-responsive">

            <table class="table tm-table tm-publicacion-accesos-table">

                <thead>

                    <tr>

                        <th>
                            Vendedor
                        </th>

                        <th>
                            Notificación
                        </th>

                        <th>
                            Acceso a publicación
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var acceso in Model)
                    {
                        <tr>

                            <!-- VENDEDOR -->
                            <td>

                                <div class="tm-publicacion-vendedor">

                                    <div class="tm-publicacion-vendedor-icono">
                                        👤
                                    </div>

                                    <strong>
                                        @acceso.Usuario
                                    </strong>

                                </div>

                            </td>


                            <!-- NOTIFICACIÓN -->
                            <td>

                                @if (acceso.Leida)
                                {
                                    <div class="tm-acceso-estado tm-acceso-si">

                                        <span class="tm-acceso-indicador">
                                            ✓
                                        </span>

                                        <div>

                                            <strong>
                                                Vista
                                            </strong>

                                            @if (acceso.FechaLectura != null)
                                            {
                                                <small>
                                                    @acceso.FechaLectura.ToString("dd/MM/yyyy HH:mm")
                                                </small>
                                            }

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <div class="tm-acceso-estado tm-acceso-no">

                                        <span class="tm-acceso-indicador">
                                            —
                                        </span>

                                        <div>
                                            <strong>
                                                No vista
                                            </strong>
                                        </div>

                                    </div>
                                }

                            </td>


                            <!-- ACCESO PUBLICACIÓN -->
                            <td>

                                @if (acceso.FechaAccesoPublicacion != null)
                                {
                                    <div class="tm-acceso-estado tm-acceso-si">

                                        <span class="tm-acceso-indicador">
                                            ✓
                                        </span>

                                        <div>

                                            <strong>
                                                Accedió
                                            </strong>

                                            <small>
                                                @acceso.FechaAccesoPublicacion.ToString("dd/MM/yyyy HH:mm")
                                            </small>

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <div class="tm-acceso-estado tm-acceso-no">

                                        <span class="tm-acceso-indicador">
                                            —
                                        </span>

                                        <div>
                                            <strong>
                                                No accedió
                                            </strong>
                                        </div>

                                    </div>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>