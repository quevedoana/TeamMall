@model IEnumerable<TeaMall.Models.Publicacion>

@{
    ViewData["Title"] = "Publicaciones";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Publicaciones</h1>
        <p class="text-muted mb-0">
            Gestión de publicaciones y comunicados
        </p>
    </div>

    @if (User.IsInRole("Administrador"))
    {
        <a asp-action="Create" class="btn btn-primary">
            + Nueva publicación
        </a>
    }
</div>


@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay publicaciones cargadas.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var publicacion in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-2">

                            <h4 class="card-title mb-0">
                                @publicacion.Titulo
                            </h4>

                            <span class="badge bg-primary">
                                @publicacion.Tipo
                            </span>

                        </div>

                        <p class="text-muted small mb-3">
                            Publicado el
                            @publicacion.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="card-text">
                            @publicacion.Descripcion
                        </p>

                        @if (!string.IsNullOrEmpty(publicacion.Archivo))
                        {
                            string extension = System.IO.Path.GetExtension(publicacion.Archivo).ToLowerInvariant();

                            if (extension == ".jpg" ||
                                extension == ".jpeg" ||
                                extension == ".png" ||
                                extension == ".gif" ||
                                extension == ".webp")
                            {
                                <div class="mb-3 text-center">
                                    <img src="@publicacion.Archivo"
                                        alt="@publicacion.Titulo"
                                        class="img-fluid rounded"
                                        style="max-height: 250px; object-fit: contain;" />
                                </div>
                            }
                            else
                            {
                                <a href="@publicacion.Archivo"
                                target="_blank"
                                class="btn btn-outline-primary btn-sm">
                                    📎 Ver archivo
                                </a>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">
                                Sin archivo adjunto
                            </span>
                        }

                    </div>

                    @if (User.IsInRole("Administrador"))
                    {
                        <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@publicacion.IdPublicacion"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@publicacion.IdPublicacion"
                               class="btn btn-danger btn-sm">
                                Eliminar
                            </a>

                            <a asp-action="Accesos"
                               asp-route-id="@publicacion.IdPublicacion"
                               class="btn btn-info btn-sm">
                                Ver accesos
                            </a>

                        </div>
                    }

                </div>

            </div>
        }

    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-4 p-3 border-top">

            <div class="text-muted small">
                Página @ViewBag.PaginaActual de @ViewBag.TotalPaginas
            </div>

            <nav aria-label="Paginación de publicaciones">

                <ul class="pagination mb-0">

                    <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                            Anterior
                        </a>

                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@i">
                                @i
                            </a>

                        </li>
                    }

                    <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                            Siguiente
                        </a>

                    </li>

                </ul>

            </nav>

        </div>
    }
}