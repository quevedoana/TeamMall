@model IEnumerable<TeaMall.Models.Publicacion>

@{
    ViewData["Title"] = "Publicaciones";
}

<div class="tm-page-header">
    <div>
        <h1 class="tm-page-title">Publicaciones</h1>

        <p class="tm-page-description">
            Gestión de publicaciones y comunicados.
        </p>
    </div>

    @if (User.IsInRole("Administrador"))
    {
        <a asp-action="Create" class="tm-btn-primary">
            + Nueva publicación
        </a>
    }
</div>


@if (!Model.Any())
{
    <div class="tm-card">
        <div class="text-center py-4">

            <h5 class="mb-2">
                No hay publicaciones cargadas
            </h5>

            <p class="text-muted mb-0">
                Todavía no se han registrado publicaciones en TeamMall.
            </p>

        </div>
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var publicacion in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="tm-card tm-publicacion-card h-100 d-flex flex-column">

                    <!-- ENCABEZADO -->
                    <div class="tm-publicacion-header">

                        <div class="tm-publicacion-info">

                            <h5 class="tm-publicacion-titulo">
                                @publicacion.Titulo
                            </h5>

                            <p class="tm-publicacion-fecha">
                                Publicado el
                                @publicacion.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
                            </p>

                        </div>

                        <span class="tm-publicacion-tipo">
                            @publicacion.Tipo
                        </span>

                    </div>


                    <!-- DESCRIPCIÓN -->
                    <div class="tm-publicacion-descripcion">

                        <p>
                            @publicacion.Descripcion
                        </p>

                    </div>


                    <!-- ARCHIVO -->
                    @if (!string.IsNullOrEmpty(publicacion.Archivo))
                    {
                        string extension =
                            System.IO.Path
                                .GetExtension(publicacion.Archivo)
                                .ToLowerInvariant();

                        if (extension == ".jpg" ||
                            extension == ".jpeg" ||
                            extension == ".png" ||
                            extension == ".gif" ||
                            extension == ".webp")
                        {
                            <div class="tm-publicacion-imagen">

                                <img src="@publicacion.Archivo"
                                    alt="@publicacion.Titulo"
                                    class="tm-imagen-publicacion-ampliable"
                                    onclick="abrirImagenPublicacion(this.src)" />

                            </div>
                        }
                        else
                        {
                            <div class="tm-publicacion-archivo-container">

                                <a href="@publicacion.Archivo"
                                   target="_blank"
                                   class="tm-publicacion-archivo">

                                    <span class="tm-publicacion-archivo-icono">
                                        📎
                                    </span>

                                    <span>
                                        Ver archivo adjunto
                                    </span>

                                </a>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="tm-publicacion-sin-archivo">

                            <span>
                                Sin archivo adjunto
                            </span>

                        </div>
                    }


                    <!-- ACCIONES ADMIN -->
                    @if (User.IsInRole("Administrador"))
                    {
                        <div class="tm-publicacion-footer">

                            <div class="tm-publicacion-acciones">

                                <a asp-action="Edit"
                                   asp-route-id="@publicacion.IdPublicacion"
                                   class="tm-btn-publicacion-edit">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@publicacion.IdPublicacion"
                                   class="tm-btn-publicacion-delete">
                                    Eliminar
                                </a>

                                <a asp-action="Accesos"
                                   asp-route-id="@publicacion.IdPublicacion"
                                   class="tm-btn-publicacion-access">
                                    Ver accesos
                                </a>

                            </div>

                        </div>
                    }

                </div>

            </div>
        }

    </div>


    <!-- PAGINACIÓN -->
    @if (ViewBag.TotalPaginas > 1)
    {
        <div class="tm-card tm-publicacion-paginacion">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div class="text-muted small">
                    Página @ViewBag.PaginaActual de @ViewBag.TotalPaginas
                </div>

                <nav aria-label="Paginación de publicaciones">

                    <ul class="pagination mb-0">

                        <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                                Anterior
                            </a>

                        </li>


                        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@i">
                                    @i
                                </a>

                            </li>
                        }


                        <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                                Siguiente
                            </a>

                        </li>

                    </ul>

                </nav>

            </div>

        </div>
    }
}
<div id="tm-modal-imagen"
     class="tm-modal-imagen"
     onclick="cerrarImagenPublicacion()">

    <span class="tm-modal-imagen-cerrar">
        &times;
    </span>

    <img id="tm-modal-imagen-contenido"
         src=""
         alt="Imagen ampliada"
         onclick="event.stopPropagation()" />

</div>

@section Scripts {

    <script>

        function abrirImagenPublicacion(src) {

            const modal = document.getElementById("tm-modal-imagen");
            const imagen = document.getElementById("tm-modal-imagen-contenido");

            imagen.src = src;

            modal.classList.add("tm-modal-imagen-visible");
        }

        function cerrarImagenPublicacion() {

            const modal = document.getElementById("tm-modal-imagen");

            modal.classList.remove("tm-modal-imagen-visible");
        }

        document.addEventListener("keydown", function (event) {

            if (event.key === "Escape") {

                cerrarImagenPublicacion();

            }

        });

    </script>

}