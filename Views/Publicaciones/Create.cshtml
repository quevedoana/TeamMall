@model TeaMall.Models.Publicacion

@{
    ViewData["Title"] = "Nueva publicación";
}

<h1>Nueva publicación</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tipo" class="form-label"></label>
                <select asp-for="Tipo" class="form-select">
                    <option value="">Seleccione un tipo</option>
                    <option value="Manual">Manual</option>
                    <option value="Capacitacion">Capacitación</option>
                    <option value="Novedad">Novedad</option>
                    <option value="Comunicacion">Comunicación</option>
                </select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Locales destinatarios</label>

                <div class="row">
                    @foreach (var local in ViewBag.Locales)
                    {
                        <div class="col-md-6 mb-2">
                            <div class="form-check">
                                <input class="form-check-input"
                                    type="checkbox"
                                    name="LocalesSeleccionados"
                                    value="@local.IdLocal"
                                    id="local_@local.IdLocal" />

                                <label class="form-check-label" for="local_@local.IdLocal">
                                    @local.Nombre
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="ArchivoSubido" class="form-label">Archivo</label>
                <input asp-for="ArchivoSubido" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,.doc,.docx,.xls,.xlsx,.zip,.rar" />
                <span asp-validation-for="ArchivoSubido" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>

        </form>

    </div>
</div>