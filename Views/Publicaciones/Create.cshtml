@model TeaMall.Models.Publicacion

@{
    ViewData["Title"] = "Nueva publicación";
}

<div class="tm-page-header">
    <div>
        <h1 class="tm-page-title">Nueva publicación</h1>

        <p class="tm-page-description">
            Creá una nueva publicación para los locales seleccionados.
        </p>
    </div>

    <a asp-action="Index" class="tm-btn-secondary">
        Volver
    </a>
</div>


<div class="tm-card tm-publicacion-form-card">

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-4">
        </div>


        <!-- TÍTULO -->
        <div class="tm-form-group">

            <label asp-for="Titulo" class="tm-form-label">
                Título
            </label>

            <input asp-for="Titulo"
                   class="form-control"
                   placeholder="Ingresá el título de la publicación" />

            <span asp-validation-for="Titulo"
                  class="text-danger">
            </span>

        </div>


        <!-- DESCRIPCIÓN -->
        <div class="tm-form-group">

            <label asp-for="Descripcion" class="tm-form-label">
                Descripción
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control tm-publicacion-textarea"
                      placeholder="Ingresá la descripción de la publicación">
            </textarea>

            <span asp-validation-for="Descripcion"
                  class="text-danger">
            </span>

        </div>


        <!-- TIPO -->
        <div class="tm-form-group">

            <label asp-for="Tipo" class="tm-form-label">
                Tipo de publicación
            </label>

            <select asp-for="Tipo"
                    class="form-select">

                <option value="">
                    Seleccione un tipo
                </option>

                <option value="Manual">
                    Manual
                </option>

                <option value="Capacitacion">
                    Capacitación
                </option>

                <option value="Novedad">
                    Novedad
                </option>

                <option value="Comunicacion">
                    Comunicación
                </option>

            </select>

            <span asp-validation-for="Tipo"
                  class="text-danger">
            </span>

        </div>


        <!-- LOCALES DESTINATARIOS -->
        <div class="tm-form-group">

            <label class="tm-form-label">
                Locales destinatarios
            </label>

            <p class="tm-form-help">
                Seleccioná uno o varios locales que recibirán esta publicación.
            </p>


            <div class="tm-locales-dropdown">

                <button type="button"
                        class="tm-locales-dropdown-button"
                        id="localesDropdownButton">

                    <span id="localesDropdownText">
                        Seleccionar locales
                    </span>

                    <span class="tm-locales-dropdown-arrow">
                        ▾
                    </span>

                </button>


                <div class="tm-locales-dropdown-menu"
                     id="localesDropdownMenu">

                     <div class="tm-locales-buscador">
                        <input type="text"
                            id="buscarLocal"
                            class="form-control"
                            placeholder="Buscar local..." />
                    </div>

                    <!-- SELECCIONAR TODOS -->
                    <div class="tm-locales-select-all">

                        <label class="tm-local-checkbox">

                            <input type="checkbox"
                                   class="form-check-input"
                                   id="seleccionarTodos" />

                            <span>
                                Seleccionar todos
                            </span>

                        </label>

                    </div>


                    <!-- LOCALES -->
                    <div class="tm-locales-list">

                        <div id="listaLocales">
                            <!-- Los locales se cargarán mediante AJAX -->
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ARCHIVO -->
        <div class="tm-form-group">

            <label asp-for="ArchivoSubido"
                   class="tm-form-label">

                Archivo adjunto

            </label>

            <p class="tm-form-help">
                Podés adjuntar PDF, imágenes, Word, Excel, ZIP o RAR.
            </p>

            <input asp-for="ArchivoSubido"
                   class="form-control"
                   accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,.doc,.docx,.xls,.xlsx,.zip,.rar" />

            <span asp-validation-for="ArchivoSubido"
                  class="text-danger">
            </span>

        </div>


        <!-- BOTONES -->
        <div class="tm-publicacion-form-actions">

            <a asp-action="Index"
               class="tm-btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="tm-btn-primary">
                Guardar publicación
            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const dropdownButton =
            document.getElementById("localesDropdownButton");

        const dropdownMenu =
            document.getElementById("localesDropdownMenu");

        const dropdownText =
            document.getElementById("localesDropdownText");

        const seleccionarTodos =
            document.getElementById("seleccionarTodos");

        const locales =
            document.querySelectorAll(".local-checkbox");
        
        const buscarLocal =
            document.getElementById("buscarLocal");


        /*
         * Abrir / cerrar selector
         */
        dropdownButton.addEventListener("click", function () {

            dropdownMenu.classList.toggle("show");

            if (dropdownMenu.classList.contains("show")) {
                buscarLocal.focus();
            }

        });


        /*
         * Cerrar si se hace clic afuera
         */
        document.addEventListener("click", function (event) {

            if (!event.target.closest(".tm-locales-dropdown")) {

                dropdownMenu.classList.remove("show");

            }

        });


        /*
         * Actualizar texto de la barra
         */
        function actualizarTextoLocales() {

            const cantidad = localesSeleccionados.size;

            if (cantidad === 0) {

                dropdownText.textContent =
                    "Seleccionar locales";

            }
            else if (cantidad === totalLocales && totalLocales > 0) {

                dropdownText.textContent =
                    "Todos los locales seleccionados";

            }
            else if (cantidad === 1) {

                dropdownText.textContent =
                    "1 local seleccionado";

            }
            else {

                dropdownText.textContent =
                    cantidad + " locales seleccionados";

            }

            seleccionarTodos.checked =
                cantidad === totalLocales && totalLocales > 0;

            seleccionarTodos.indeterminate =
                cantidad > 0 && cantidad < totalLocales;
        }

        const listaLocales = document.getElementById("listaLocales");

        let localesSeleccionados = new Set();
        let totalLocales = 0;
        async function buscarLocalesAjax(texto = "") {
            try {
                const respuesta = await fetch(
                    `/Publicaciones/BuscarLocales?texto=${encodeURIComponent(texto)}`
                );

                if (!respuesta.ok) {
                    throw new Error("No se pudieron obtener los locales.");
                }

                const locales = await respuesta.json();
                if (texto === "") {
                    totalLocales = locales.length;
                }
                listaLocales.innerHTML = "";

                locales.forEach(local => {
                    const label = document.createElement("label");
                    label.className = "tm-local-checkbox";
                    label.dataset.nombre = local.nombre;

                    const checkbox = document.createElement("input");
                    checkbox.type = "checkbox";
                    checkbox.className = "local-checkbox";
                    checkbox.name = "LocalesSeleccionados";
                    checkbox.value = local.idLocal;

                    checkbox.checked = localesSeleccionados.has(local.idLocal);

                    checkbox.addEventListener("change", function () {
                        if (this.checked) {
                            localesSeleccionados.add(local.idLocal);
                        } else {
                            localesSeleccionados.delete(local.idLocal);
                        }

                        actualizarTextoLocales();
                    });

                    const span = document.createElement("span");
                    span.textContent = local.nombre;

                    label.appendChild(checkbox);
                    label.appendChild(span);

                    listaLocales.appendChild(label);
                });

            } catch (error) {
                console.error("Error al buscar locales:", error);
            }
        }

        buscarLocal.addEventListener("input", function () {
            buscarLocalesAjax(this.value.trim());
        });

        buscarLocalesAjax();

        /*
         * Seleccionar todos
         */
        seleccionarTodos.addEventListener("change", function () {
            const checked = this.checked;

            document.querySelectorAll(".local-checkbox").forEach(checkbox => {
                checkbox.checked = checked;

                const idLocal = parseInt(checkbox.value);

                if (checked) {
                    localesSeleccionados.add(idLocal);
                } else {
                    localesSeleccionados.delete(idLocal);
                }
            });

            actualizarTextoLocales();
        });


        /*
         * Detectar cambios individuales
         */
        document.querySelectorAll(".local-checkbox")
            .forEach(function (checkbox) {

                checkbox.addEventListener("change", function () {

                    actualizarTextoLocales();

                });

            });


        /*
         * Estado inicial
         */
        actualizarTextoLocales();

    </script>
}