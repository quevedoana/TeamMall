@model TeaMall.Models.Publicacion

@{
    ViewData["Title"] = "Publicación";
}

<div class="tm-page-header">

    <div>
        <h1 class="tm-page-title">
            @Model.Titulo
        </h1>

        <p class="tm-page-description">
            Detalle de la publicación recibida.
        </p>
    </div>

</div>


<div class="tm-card tm-notificacion-publicacion-card">

    <!-- ENCABEZADO -->

    <div class="tm-notificacion-publicacion-header">

        <div>
            <span class="tm-notificacion-publicacion-tipo">
                @Model.Tipo
            </span>

            <h2>
                @Model.Titulo
            </h2>
        </div>

    </div>


    <!-- CONTENIDO -->

    <div class="tm-notificacion-publicacion-contenido">

        <div class="tm-notificacion-publicacion-descripcion">
            @Model.Descripcion
        </div>


        <div class="tm-notificacion-publicacion-fecha">

            <span class="tm-notificacion-publicacion-fecha-label">
                Publicado el
            </span>

            <span>
                @Model.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
            </span>

        </div>


        @if (!string.IsNullOrEmpty(Model.Archivo))
        {
            string extension = System.IO.Path
                .GetExtension(Model.Archivo)
                .ToLowerInvariant();

            if (extension == ".jpg" ||
                extension == ".jpeg" ||
                extension == ".png" ||
                extension == ".gif" ||
                extension == ".webp")
            {
                <div class="tm-notificacion-publicacion-imagen">

                    <img src="@Model.Archivo"
                        alt="@Model.Titulo"
                        class="tm-imagen-publicacion-ampliable"
                        onclick="abrirImagenPublicacion(this.src)" />

                </div>
            }
            else
            {
                <div class="tm-notificacion-publicacion-archivo">

                    <div class="tm-notificacion-publicacion-archivo-icono">
                        📎
                    </div>

                    <div class="tm-notificacion-publicacion-archivo-info">

                        <strong>
                            Archivo adjunto
                        </strong>

                        <span>
                            Podés abrir el archivo asociado a esta publicación.
                        </span>

                    </div>

                    <a href="@Model.Archivo"
                       target="_blank"
                       class="tm-btn-notificacion">
                        Ver archivo
                    </a>

                </div>
            }
        }

    </div>


    <!-- ACCIONES -->

    <div class="tm-notificacion-publicacion-footer">

        <a asp-action="Index"
           class="tm-btn-secondary">
            Volver a notificaciones
        </a>

    </div>

</div>
<div id="tm-modal-imagen"
     class="tm-modal-imagen"
     onclick="cerrarImagenPublicacion()">

    <span class="tm-modal-imagen-cerrar">
        &times;
    </span>

    <img id="tm-modal-imagen-contenido"
         src=""
         alt="Imagen ampliada"
         onclick="event.stopPropagation()" />

</div>

@section Scripts {

    <script>

        function abrirImagenPublicacion(src) {

            const modal = document.getElementById("tm-modal-imagen");
            const imagen = document.getElementById("tm-modal-imagen-contenido");

            imagen.src = src;

            modal.classList.add("tm-modal-imagen-visible");
        }

        function cerrarImagenPublicacion() {

            const modal = document.getElementById("tm-modal-imagen");

            modal.classList.remove("tm-modal-imagen-visible");
        }

        document.addEventListener("keydown", function (event) {

            if (event.key === "Escape") {

                cerrarImagenPublicacion();

            }

        });

    </script>

}