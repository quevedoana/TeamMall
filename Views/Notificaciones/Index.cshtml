@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Notificaciones";
}

<div class="container mt-4">

    <h2>Notificaciones</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">
            No tenés notificaciones nuevas.
        </div>
    }
    else
    {
        <div class="list-group mt-3">

            @foreach (var item in Model)
            {
                var notificacion = item.Notificacion;
                var publicacion = item.Publicacion;

                <div class="list-group-item">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <strong>@publicacion.Titulo</strong>

                            <div class="text-muted">
                                @publicacion.Descripcion
                            </div>

                            <small class="text-muted">
                                @notificacion.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>

                        <div class="text-end">

                            @if (notificacion.Leida)
                            {
                                <span class="badge bg-secondary">
                                    Leída
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary">
                                    Nueva
                                </span>
                            }

                            <div class="mt-2">
                                <a asp-action="VerPublicacion"
                                asp-route-id="@publicacion.IdPublicacion"
                                class="btn btn-sm btn-primary">
                                    Ver publicación
                                </a>
                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>