@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Notificaciones";
}

<div class="tm-page-header">

    <div>
        <h1 class="tm-page-title">
            Notificaciones
        </h1>

        <p class="tm-page-description">
            Comunicaciones y publicaciones dirigidas a tu local.
        </p>
    </div>

</div>


<div class="tm-card tm-notificaciones-card">

    @if (!Model.Any())
    {
        <div class="tm-notificaciones-vacio">

            <div class="tm-notificaciones-vacio-icono">
                ✓
            </div>

            <h5>
                No tenés notificaciones nuevas
            </h5>

            <p>
                Cuando recibas una nueva publicación, aparecerá acá.
            </p>

        </div>
    }
    else
    {
        <div class="tm-notificaciones-lista">

            @foreach (var item in Model)
            {
                var notificacion = item.Notificacion;
                var publicacion = item.Publicacion;

                <div class="tm-notificacion-item @(notificacion.Leida ? "" : "tm-notificacion-no-leida")">

                    <!-- INFORMACIÓN -->
                    <div class="tm-notificacion-contenido">

                        <div class="tm-notificacion-titulo-row">

                            <h5>
                                @publicacion.Titulo
                            </h5>

                            @if (notificacion.Leida)
                            {
                                <span class="tm-notificacion-badge tm-notificacion-leida">
                                    Leída
                                </span>
                            }
                            else
                            {
                                <span class="tm-notificacion-badge tm-notificacion-nueva">
                                    Nueva
                                </span>
                            }

                        </div>


                        <p class="tm-notificacion-descripcion">
                            @publicacion.Descripcion
                        </p>


                        <div class="tm-notificacion-meta">

                            <span>
                                @publicacion.Tipo
                            </span>

                            <span class="tm-notificacion-separador">
                                •
                            </span>

                            <span>
                                @notificacion.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                            </span>

                        </div>

                    </div>


                    <!-- ACCIÓN -->
                    <div class="tm-notificacion-accion">

                        <a asp-action="VerPublicacion"
                           asp-route-id="@publicacion.IdPublicacion"
                           class="tm-btn-notificacion">
                            Ver publicación
                        </a>

                    </div>

                </div>
            }

        </div>
    }

</div>