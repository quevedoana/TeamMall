@model TeaMall.Models.Usuario

@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 fw-bold">Mi perfil</h1>
        <p class="text-muted">Consultá y actualizá tus datos personales.</p>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <div class="tm-card p-4">
        <form asp-action="Index"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="text-center mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                {
                    <img src="@Model.Avatar"
                         alt="Avatar del usuario"
                         class="rounded-circle mb-3"
                         style="width:120px;height:120px;object-fit:cover;" />
                }
                else
                {
                    <div class="tm-user-avatar mx-auto mb-3"
                         style="width:120px;height:120px;font-size:40px;">
                        @Model.Nombre.Substring(0, 1).ToUpper()
                    </div>
                }

                <div>
                    <label for="avatar" class="form-label fw-semibold">
                        Foto de perfil
                    </label>
                    <input type="file"
                           id="avatar"
                           name="avatar"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />
                    <span asp-validation-for="Avatar"
                          class="text-danger"></span>
                    <small class="text-muted">
                        JPG, PNG o WEBP. Máximo 2 MB.
                    </small>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="nombre">Nombre</label>
                    <input id="nombre"
                           name="nombre"
                           value="@Model.Nombre"
                           class="form-control"
                           maxlength="50"
                           required />
                    <span class="text-danger">
                        @Html.ValidationMessage("nombre")
                    </span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="apellido">Apellido</label>
                    <input id="apellido"
                           name="apellido"
                           value="@Model.Apellido"
                           class="form-control"
                           maxlength="50"
                           required />
                    <span class="text-danger">
                        @Html.ValidationMessage("apellido")
                    </span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="email">Email</label>
                    <input id="email"
                           name="email"
                           type="email"
                           value="@Model.Email"
                           class="form-control"
                           maxlength="100"
                           required />
                    <span class="text-danger">
                        @Html.ValidationMessage("email")
                    </span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">DNI</label>
                    <input value="@Model.DNI"
                           class="form-control"
                           readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Rol</label>
                    <input value="@Model.Rol"
                           class="form-control"
                           readonly />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="submit" class="btn tm-btn-primary">
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>