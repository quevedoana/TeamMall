
@{
    ViewData["Title"] = "Inicio";
}

<div class="tm-page-header">
    <div>
        <h1 class="tm-page-title">¡Bienvenido a TeamMall!</h1>
        <p class="tm-page-description">
            Panel de gestión y comunicación interna.
        </p>
    </div>
</div>

<div class="tm-card mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="tm-brand-symbol">T</div>
        <div>
            <h5 class="mb-1">Tu espacio de trabajo</h5>
            <p class="text-secondary mb-0">
                Desde acá podrás gestionar los locales,
                los usuarios y las comunicaciones internas.
            </p>
        </div>
    </div>
</div>

<!-- Horarios de todos los locales -->
<div class="tm-card mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div>
            <h4 class="mb-1">Horarios de los locales</h4>
            <p class="text-secondary mb-0">
                Consultá la planilla general y los horarios de todos los locales.
            </p>
        </div>

        <a href="https://docs.google.com/spreadsheets/d/1fyf_E3BKftPZfA9Vrcc4gAc_18rsAkIm/edit"
           target="_blank"
           rel="noopener noreferrer"
           class="btn tm-btn-primary">
            Abrir en Google Sheets ↗
        </a>
    </div>

    <div class="d-flex align-items-center gap-2 text-secondary small mb-3">
        <span>🕒</span>
        <span>
            Última actualización:
            <strong id="fechaActualizacionHorarios">
                Consultando fecha de actualización...
            </strong>
        </span>
    </div>

    <div class="rounded-3 overflow-hidden border">
        <iframe
            src="https://docs.google.com/spreadsheets/d/1fyf_E3BKftPZfA9Vrcc4gAc_18rsAkIm/preview"
            title="Planilla de horarios de todos los locales"
            width="100%"
            height="650"
            style="border: 0; display: block;"
            loading="lazy"
            allowfullscreen>
        </iframe>
    </div>

    <p class="text-secondary small mt-3 mb-0">
        Si la planilla no se muestra, verificá que tengas permiso para verla
        con tu cuenta de Google.
    </p>
</div>

<!-- Accesos rápidos -->
<div class="row g-4">
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-controller="Locales"
           asp-action="Index"
           class="tm-shortcut">
            <div class="tm-shortcut-icon">▤</div>
            <div>
                <h5>Locales</h5>
                <p>Administrá los locales comerciales.</p>
            </div>
            <span class="tm-shortcut-arrow">→</span>
        </a>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <a asp-controller="Usuarios"
           asp-action="Index"
           class="tm-shortcut">
            <div class="tm-shortcut-icon">♙</div>
            <div>
                <h5>Usuarios</h5>
                <p>Consultá y gestioná los usuarios.</p>
            </div>
            <span class="tm-shortcut-arrow">→</span>
        </a>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <div class="tm-shortcut tm-shortcut-disabled">
            <div class="tm-shortcut-icon">▧</div>
            <div>
                <h5>Publicaciones</h5>
                <p>Próximamente disponible.</p>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', async function () {
        const elemento = document.getElementById(
            'fechaActualizacionHorarios'
        );

        if (!elemento) {
            return;
        }

        try {
            const respuesta = await fetch(
                '@Url.Action("ObtenerFechaActualizacion", "Home")'
            );

            if (!respuesta.ok) {
                throw new Error(
                    'El servidor respondió con el estado ' + respuesta.status
                );
            }

            const datos = await respuesta.json();

            if (!datos.success || !datos.fecha) {
                throw new Error(
                    datos.mensaje || 'No se recibió una fecha válida.'
                );
            }

            const fecha = new Date(datos.fecha);

            if (Number.isNaN(fecha.getTime())) {
                throw new Error('La fecha recibida no es válida.');
            }

            elemento.textContent = new Intl.DateTimeFormat('es-AR', {
                dateStyle: 'long',
                timeStyle: 'short',
                timeZone: 'America/Argentina/Buenos_Aires'
            }).format(fecha);

        } catch (error) {
            console.error(
                'Error al consultar la fecha de Google Drive:',
                error
            );

            elemento.textContent =
                'No se pudo consultar la fecha de actualización';
        }
    });
</script>
